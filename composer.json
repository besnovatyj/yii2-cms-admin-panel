{
  "name": "besnovatyj/yii2-cms-admin-panel",
  "description": "Глобальный модуль админ-панели: индекс меню всех локаций, палитра команд (Ctrl/Cmd+K), кнопки быстрых действий в шапке и страница «Настройки»",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "version": "1.0.0",
  "extra": {
    "moduleClass": "Besnovatyj\\AdminPanel\\Module",
    "moduleId": "AdminPanel",
    "bescms": {
      "kind": "module"
    },
    "config-plugin": {
      "admin-menu": "src/config/adminMenu.php",
      "common": "src/config/common.php",
      "app-backend": "src/config/backend.php"
    }
  },
  "keywords": [
    "yii2",
    "cms",
    "admin",
    "navigation",
    "command-palette"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "besnovatyj/yii2-cms-contracts": "^1.0",
    "besnovatyj/yii2-cms-kernel": "^1.0",
    "besnovatyj/yii2-cms-modman": "^1.0",
    "php": ">=8.4",
    "yiisoft/yii2": "~2.0",
    "yiisoft/yii2-bootstrap5": "~2.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\AdminPanel\\": "src/"
    }
  }
}
